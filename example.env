# ── Redpanda / Kafka ─────────────────────────────────────
REDPANDA_BOOTSTRAP=seed-xxx.xxx.redpanda.com:9092
REDPANDA_USERNAME=your-user
REDPANDA_PASSWORD=your-password
REDPANDA_TOPIC=payments.raw

# ── NeonDB ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# ── MLflow ───────────────────────────────────────────────
# Serveur réutilisé depuis IDNet
MLFLOW_TRACKING_URI=https://your-mlflow-space.hf.space
MLFLOW_TRACKING_USERNAME=your-user
MLFLOW_TRACKING_PASSWORD=your-password

# ── AWS S3 ───────────────────────────────────────────────
# Bucket partagé — ARTIFACT_ROOT sur HF Space pointe vers la racine
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_DEFAULT_REGION=default_region 

# ── Prefect ──────────────────────────────────────────────
PREFECT_API_KEY=your-prefect-api-key
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>

# ── Alertes ──────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx